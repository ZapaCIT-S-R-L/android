<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No cloud or device-to-device backup: chat keys and sessions must never come back through a backup.
         Chat-key recovery uses Android Block Store (end-to-end encrypted by Google) in a later change. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Retry key setup as soon as the network is back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ZapaKidApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZapaKid"
        tools:targetApi="37">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ZapaKid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sign in with Apple returns here. Verified App Link: needs /.well-known/assetlinks.json on zapakid.ro
                 with this app's signing certificate, so no other app can receive the link. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="zapakid.ro" />
                <data android:path="/app/apple" />
            </intent-filter>
        </activity>
    </application>
</manifest>
